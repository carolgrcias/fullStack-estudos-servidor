<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Lista de Produtos</title>
</head>
<body>
    <h1>Produtos</h1>

    <ul>
        <% items.forEach(function (p) { %>
            <li><%= p.descricao %> - R$ <%= p.valor %></li>
        <% }) %>
    </ul>

    <a href="cadastro_produto.html">Cadastrar novo produto</a>
</body>
</html>